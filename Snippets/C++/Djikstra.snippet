	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>Djikstra</Title>
			<Shortcut>Djikstra</Shortcut>
			<Description>Code snippet for Djikstra</Description>
			<Author>Davit Bakhshyan</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
				<SnippetType>SurroundsWith</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="cpp">
	<![CDATA[void Djikstra(vector < vector < pair<int, int>>>& gr)
{
	int n = gr.size();
	vector<int> d(n, INF);

	d[0] = 0;
	priority_queue < pair<int, int>, vector<pair<int, int>>, greater<>> pq;
	pq.push({ 0,0 });

	while (!pq.empty())
	{
		int v = pq.top().second, cur_d = pq.top().first;
		pq.pop();

		if (cur_d > d[v])
			continue;

		for (auto& i : gr[v])
		{
			int to = i.first;
			int cost = i.second;

			if (d[v] + cost < d[to])
			{
				d[to] = d[v] + cost;
				pq.push({ d[to], to });
			}
		}
	}
}$end$]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>