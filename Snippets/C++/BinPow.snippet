<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets>
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>BinPow</Title>
			<Shortcut>BinPow</Shortcut>
			<Description>Code snippet for BinPow</Description>
			<Author>Davit Bakhshyan</Author>
			<SnippetTypes>
				<SnippetType>Expansion</SnippetType>
				<SnippetType>SurroundsWith</SnippetType>
			</SnippetTypes>
		</Header>
		<Snippet>
			<Code Language="cpp"><![CDATA[int binpow(int a, int b, int m = MOD)
{
	int res = 1;
	a %= m;
	while (b > 0) {
		if (b & 1) res = res * a % m;
		a = a * a % m;
		b >>= 1;
	}
	return res;
}$end$]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
